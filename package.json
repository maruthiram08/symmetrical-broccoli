{
  "name": "daily-brief",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "daily-brief": "bin/daily-brief"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4242",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4242",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "app": "next build && next start -H 127.0.0.1 -p 4242",
    "install-login": "zsh scripts/install-login.sh",
    "build:standalone": "NEXT_OUTPUT_STANDALONE=1 next build",
    "uninstall-login": "zsh scripts/uninstall-login.sh",
    "keychain:import": "tsx scripts/keychain-import.ts",
    "mac:build": "zsh scripts/mac-build.sh",
    "tauri": "tauri",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:install": "zsh scripts/install-mcp.sh",
    "hosted:check": "tsx scripts/hosted-check.ts",
    "hosted:migrate": "tsx scripts/hosted-migrate.ts",
    "cli": "tsx src/cli/main.ts",
    "cli:install": "sh scripts/install-cli.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@google/genai": "3.2.0",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@mistralai/mistralai": "3.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/sdk": "1.5.91",
    "chrono-node": "2.10.3",
    "d3-force": "3.0.0",
    "docx": "9.15.3",
    "groq-sdk": "1.6.0",
    "ignore": "7.0.14",
    "katex": "0.16.22",
    "mermaid": "11.17.2",
    "minisearch": "7.2.0",
    "next": "^15.5.29",
    "nodemailer": "7.0.13",
    "openai": "7.55.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-force": "3.0.10",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@lezer/common": "1.5.5",
    "@lezer/lr": "1.4.12",
    "style-mod": "4.1.4",
    "@lezer/javascript": "1.5.6",
    "@codemirror/lint": "6.9.7",
    "docx": {
      "@types/node": "26.6.6"
    }
  }
}
