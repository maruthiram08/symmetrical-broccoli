{
  "name": "daily-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4242",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4242",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "app": "next build && next start -H 127.0.0.1 -p 4242",
    "install-login": "zsh scripts/install-login.sh",
    "build:standalone": "NEXT_OUTPUT_STANDALONE=1 next build",
    "uninstall-login": "zsh scripts/uninstall-login.sh",
    "keychain:import": "tsx scripts/keychain-import.ts",
    "mac:build": "zsh scripts/mac-build.sh",
    "tauri": "tauri",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:install": "zsh scripts/install-mcp.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
