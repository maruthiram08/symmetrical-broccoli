{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Brief",
  "version": "0.1.0",
  "identifier": "app.dailybrief.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.productivity",
    "shortDescription": "Your meetings, turned into your day",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../build/app-server/": "server/",
      "../build/node-runtime/": "node-runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libsecret-tools",
          "libnotify-bin"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
