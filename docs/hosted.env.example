# Copy to .env.hosted (git ignores it) for npm run hosted:check / hosted:migrate,
# and put the same values in Vercel > Settings > Environment Variables. See docs/HOSTED.md.
DAILY_BRIEF_MODE=hosted
APP_URL=https://your-app.vercel.app
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_CA_CERT=
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Daily brief <brief@your-domain.com>
ALLOWED_EMAILS=you@example.com,friend@example.com

# Optional: billing (Razorpay TEST mode only) and teams
BILLING_ENABLED=0
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
FREE_MEETINGS_PER_MONTH=20
REFERRAL_FREE_DAYS=30
TEAMS_ENABLED=0
